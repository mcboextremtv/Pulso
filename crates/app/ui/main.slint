import { ListView, LineEdit, TextEdit } from "std-widgets.slint";

export struct TrackItem { id: int, title: string, artist: string, album: string, duration: string }
export struct LyricLine { text: string, current: bool }
export struct FolderItem { path: string, name: string, depth: int, count: int }

component IconButton inherits Rectangle {
    in property <length> size: 40px;
    in property <color> fill: #ffffff14;
    callback clicked;
    width: size;
    height: size;
    border-radius: size / 2;
    background: ta.has-hover ? #ffffff2e : fill;
    @children
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;
    height: 30px;
    border-radius: 6px;
    background: root.primary ? (ta.has-hover ? #3b82f6 : #2f6fe0) : (ta.has-hover ? #ffffff2e : #ffffff14);
    Text { text: root.label; color: #ffffff; font-size: 12px; overflow: elide; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Bar inherits Rectangle {
    in property <float> value;
    callback changed(float);
    height: 16px;
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff1f;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.value, 0.0, 1.0);
            border-radius: 2px;
            background: ta.has-hover ? #8ab4ff : #e8eaed;
        }
    }
    ta := TouchArea {
        clicked => { root.changed(clamp(self.mouse-x / self.width, 0.0, 1.0)); }
    }
}

export component MainWindow inherits Window {
    title: "Pulso";
    preferred-width: 1180px;
    preferred-height: 640px;
    min-width: 920px;
    min-height: 480px;
    background: #0e1014;

    in property <[TrackItem]> tracks;
    in property <[LyricLine]> lyrics;
    in property <string> lyrics-status;
    in property <int> current-id: -1;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <string> status-text;
    in property <float> progress;
    in property <bool> playing;
    in-out property <float> volume: 0.8;
    in property <[FolderItem]> folders;
    in-out property <string> selected-folder: "";
    in-out property <bool> editing: false;
    in-out property <string> edit-text;
    in-out property <string> edit-artist;
    in-out property <string> edit-title;
    in property <string> edit-name;
    in property <string> edit-status;

    callback open-folder();
    callback play-track(int);
    callback toggle-play();
    callback prev();
    callback next();
    callback seek(float);
    callback volume-changed(float);
    callback search(string);
    callback folder-selected(string);
    callback edit-lyrics();
    callback cancel-edit();
    callback save-lyrics(string);
    callback delete-lyrics();
    callback search-lyrics(string, string);
    callback web-lyrics(string, string);

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // ---- Carpetas ----
            Rectangle {
                width: 220px;
                background: #0b0d11;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: "Carpetas"; color: #9aa0a6; font-size: 12px; }
                    ListView {
                        vertical-stretch: 1;
                        for f[i] in root.folders: Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: f.path == root.selected-folder ? #22304a : (fta.has-hover ? #ffffff0d : transparent);
                            HorizontalLayout {
                                padding-left: 10px + f.depth * 14px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text { text: f.name; color: f.path == root.selected-folder ? #ffffff : #c4c7cc; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "\{f.count}"; color: #6b7280; font-size: 11px; vertical-alignment: center; }
                            }
                            fta := TouchArea { clicked => { root.folder-selected(f.path); } }
                        }
                    }
                }
            }

            // ---- Biblioteca ----
            VerticalLayout {
                horizontal-stretch: 3;
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        background: #1a1d24;
                        border-radius: 8px;
                        search-input := TextInput {
                            x: 12px;
                            y: (parent.height - self.height) / 2;
                            width: parent.width - 24px;
                            color: #ffffff;
                            font-size: 14px;
                            edited => { root.search(self.text); }
                        }
                        Text {
                            x: 12px;
                            y: (parent.height - self.height) / 2;
                            text: "Buscar en tu biblioteca";
                            color: #6b7280;
                            font-size: 14px;
                            visible: search-input.text == "";
                        }
                    }
                    Rectangle {
                        width: 130px;
                        height: 36px;
                        border-radius: 8px;
                        background: open-ta.has-hover ? #3b82f6 : #2f6fe0;
                        Text { text: "Agregar carpeta"; color: #ffffff; font-size: 13px; }
                        open-ta := TouchArea { clicked => { root.open-folder(); } }
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for t[i] in root.tracks: Rectangle {
                        height: 44px;
                        border-radius: 6px;
                        background: t.id == root.current-id ? #22304a : (row-ta.has-hover ? #ffffff0d : transparent);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            Text { text: t.title; color: #ffffff; font-size: 14px; overflow: elide; vertical-alignment: center; horizontal-stretch: 3; }
                            Text { text: t.artist; color: #9aa0a6; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 2; }
                            Text { text: t.duration; color: #9aa0a6; font-size: 13px; width: 48px; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        row-ta := TouchArea { double-clicked => { root.play-track(i); } }
                    }
                }

                Text { text: root.status-text; color: #6b7280; font-size: 12px; }
            }

            // ---- Letra ----
            Rectangle {
                width: 340px;
                background: #12151b;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.editing ? "Editar letra" : "Letra"; color: #9aa0a6; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                        if !root.editing && root.current-id >= 0: TextButton { label: "Editar"; width: 64px; clicked => { root.edit-lyrics(); } }
                        if !root.editing && root.current-id >= 0: TextButton { label: "Eliminar"; width: 72px; clicked => { root.delete-lyrics(); } }
                    }
                    if !root.editing: Text { text: root.lyrics-status; color: #6b7280; font-size: 12px; wrap: word-wrap; visible: root.lyrics-status != ""; }
                    if !root.editing: ListView {
                        vertical-stretch: 1;
                        for l in root.lyrics: Text {
                            height: 32px;
                            text: l.text;
                            overflow: elide;
                            vertical-alignment: center;
                            color: l.current ? #ffffff : #6b7280;
                            font-size: l.current ? 18px : 15px;
                            font-weight: l.current ? 700 : 400;
                        }
                    }
                    if root.editing: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 8px;
                        Text { text: root.edit-name; color: #c4c7cc; font-size: 12px; overflow: elide; }
                        LineEdit { placeholder-text: "Artista"; text <=> root.edit-artist; }
                        LineEdit { placeholder-text: "Título"; text <=> root.edit-title; }
                        HorizontalLayout {
                            spacing: 6px;
                            TextButton { label: "Buscar letra"; clicked => { root.search-lyrics(root.edit-artist, root.edit-title); } }
                            TextButton { label: "Buscar en la web"; clicked => { root.web-lyrics(root.edit-artist, root.edit-title); } }
                        }
                        Text { text: root.edit-status; color: #8ab4ff; font-size: 11px; wrap: word-wrap; visible: root.edit-status != ""; }
                        TextEdit { vertical-stretch: 1; text <=> root.edit-text; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 6px;
                            TextButton { label: "Guardar"; primary: true; clicked => { root.save-lyrics(root.edit-text); } }
                            TextButton { label: "Cancelar"; clicked => { root.cancel-edit(); } }
                        }
                    }
                }
            }
        }

        // ---- Barra de reproducción ----
        Rectangle {
            height: 84px;
            background: #12151b;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 20px;

                VerticalLayout {
                    width: 240px;
                    alignment: center;
                    Text { text: root.now-title; color: #ffffff; font-size: 14px; font-weight: 600; overflow: elide; }
                    Text { text: root.now-artist; color: #9aa0a6; font-size: 12px; overflow: elide; }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 14px;
                        IconButton {
                            size: 34px;
                            clicked => { root.prev(); }
                            Rectangle { x: (parent.width - 14px) / 2; y: (parent.height - 12px) / 2; width: 2px; height: 12px; background: #ffffff; }
                            Path { x: (parent.width - 14px) / 2 + 3px; y: (parent.height - 12px) / 2; width: 11px; height: 12px; viewbox-width: 11; viewbox-height: 12; commands: "M 11 0 L 0 6 L 11 12 Z"; fill: #ffffff; }
                        }
                        IconButton {
                            size: 44px;
                            fill: #e8eaed;
                            clicked => { root.toggle-play(); }
                            Path {
                                visible: !root.playing;
                                x: (parent.width - 14px) / 2 + 1px; y: (parent.height - 16px) / 2;
                                width: 14px; height: 16px; viewbox-width: 14; viewbox-height: 16;
                                commands: "M 0 0 L 14 8 L 0 16 Z"; fill: #0e1014;
                            }
                            Rectangle { visible: root.playing; x: (parent.width - 12px) / 2; y: (parent.height - 16px) / 2; width: 4px; height: 16px; background: #0e1014; }
                            Rectangle { visible: root.playing; x: (parent.width - 12px) / 2 + 8px; y: (parent.height - 16px) / 2; width: 4px; height: 16px; background: #0e1014; }
                        }
                        IconButton {
                            size: 34px;
                            clicked => { root.next(); }
                            Path { x: (parent.width - 14px) / 2; y: (parent.height - 12px) / 2; width: 11px; height: 12px; viewbox-width: 11; viewbox-height: 12; commands: "M 0 0 L 11 6 L 0 12 Z"; fill: #ffffff; }
                            Rectangle { x: (parent.width - 14px) / 2 + 12px; y: (parent.height - 12px) / 2; width: 2px; height: 12px; background: #ffffff; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: root.position-text; color: #9aa0a6; font-size: 11px; width: 40px; horizontal-alignment: right; vertical-alignment: center; }
                        Bar { horizontal-stretch: 1; value: root.progress; changed(v) => { root.seek(v); } }
                        Text { text: root.duration-text; color: #9aa0a6; font-size: 11px; width: 40px; vertical-alignment: center; }
                    }
                }

                VerticalLayout {
                    width: 140px;
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Vol"; color: #9aa0a6; font-size: 11px; vertical-alignment: center; }
                        Bar { horizontal-stretch: 1; value: root.volume; changed(v) => { root.volume = v; root.volume-changed(v); } }
                    }
                }
            }
        }
    }
}
