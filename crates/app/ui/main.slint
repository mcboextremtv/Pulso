import { ListView, ScrollView, LineEdit, TextEdit } from "std-widgets.slint";

export struct TrackItem { id: int, index: int, header: bool, title: string, artist: string, album: string, duration: string }
export struct LyricLine { text: string, current: bool }
export struct FolderItem { path: string, name: string, depth: int, count: int }
export struct PlaylistItem { id: int, name: string, count: int }

component IconButton inherits Rectangle {
    in property <length> size: 40px;
    in property <color> fill: #ffffff14;
    callback clicked;
    width: size;
    height: size;
    border-radius: size / 2;
    background: ta.has-hover ? #ffffff2e : fill;
    @children
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;
    height: 30px;
    border-radius: 6px;
    background: root.primary ? (ta.has-hover ? #3b82f6 : #2f6fe0) : (ta.has-hover ? #ffffff2e : #ffffff14);
    Text { text: root.label; color: #ffffff; font-size: 12px; overflow: elide; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Bar inherits Rectangle {
    in property <float> value;
    callback changed(float);
    height: 16px;
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff1f;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.value, 0.0, 1.0);
            border-radius: 2px;
            background: ta.has-hover ? #8ab4ff : #e8eaed;
        }
    }
    ta := TouchArea {
        clicked => { root.changed(clamp(self.mouse-x / self.width, 0.0, 1.0)); }
    }
}

// Divisor que se arrastra con el ratón. `sign` = -1 si el panel que cambia está a la derecha.
component Splitter inherits Rectangle {
    in-out property <length> value;
    in property <length> min-value: 100px;
    in property <length> max-value: 600px;
    in property <float> sign: 1;
    callback released();
    width: 6px;
    background: (ta.has-hover || ta.pressed) ? #3b82f666 : transparent;
    ta := TouchArea {
        mouse-cursor: MouseCursor.col-resize;
        moved => {
            if (self.pressed) {
                root.value = clamp(root.value + root.sign * (self.mouse-x - self.pressed-x), root.min-value, root.max-value);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> desc;
    callback clicked();
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        spacing: 6px;
        Text { text: root.label; color: root.active ? #ffffff : #9aa0a6; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        if root.active: Rectangle {
            width: 8px;
            Path {
                x: 0px;
                y: (parent.height - 6px) / 2;
                width: 8px;
                height: 6px;
                viewbox-width: 8;
                viewbox-height: 6;
                commands: root.desc ? "M 0 0 L 8 0 L 4 6 Z" : "M 0 6 L 4 0 L 8 6 Z";
                fill: #8ab4ff;
            }
        }
    }
}

component LyricRow inherits Text {
    in property <bool> current;
    callback became-current(length);
    wrap: word-wrap;
    color: root.current ? #ffffff : #6b7280;
    font-size: root.current ? 18px : 15px;
    font-weight: root.current ? 700 : 400;
    changed current => {
        if (self.current) { self.became-current(self.y); }
    }
}

export component MainWindow inherits Window {
    title: "Pulso";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 680px;
    min-width: 900px;
    min-height: 480px;
    background: #0e1014;

    in property <[TrackItem]> tracks;
    in property <[LyricLine]> lyrics;
    in property <[FolderItem]> folders;
    in property <[PlaylistItem]> playlists;      // incluye «Todas las canciones» con id -1
    in property <[PlaylistItem]> pick-lists;     // solo listas reales (para «añadir a…»)
    in-out property <string> sidebar-mode: "folders";
    in-out property <int> selected-playlist: -1;
    property <bool> in-playlist: root.sidebar-mode == "lists" && root.selected-playlist >= 0;
    in property <string> lyrics-status;
    in property <int> current-id: -1;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <string> status-text;
    in property <float> progress;
    in property <bool> playing;
    in property <int> underruns;
    in-out property <float> volume: 0.8;
    in-out property <string> selected-folder: "";

    // Diseño (se guarda entre sesiones)
    in-out property <length> sidebar-w: 220px;
    in-out property <length> lyrics-w: 340px;
    in-out property <length> title-w: 260px;
    in-out property <length> artist-w: 160px;
    // Espacio útil para título + artista + álbum, y anchos efectivos: si el panel se estrecha,
    // las columnas se encogen para que "Dur." y el lápiz nunca queden fuera.
    property <length> center-w: 640px; // se actualiza desde el panel central (evita un bucle de diseño)
    property <length> avail: max(200px, root.center-w - 32px - 186px);
    property <length> eff-artist: min(root.artist-w, max(60px, root.avail * 0.4));
    property <length> eff-title: min(root.title-w, max(80px, root.avail - root.eff-artist - 60px));
    in-out property <string> sort-col: "";
    in-out property <bool> sort-desc: false;
    in-out property <bool> group-artist: false;
    in-out property <int> audio-buffer: 8192;

    // Editor de letra
    in-out property <bool> editing: false;
    in-out property <string> edit-text;
    in-out property <string> edit-artist;
    in-out property <string> edit-title;
    in property <string> edit-name;
    in property <string> edit-status;

    // Editor de etiquetas y ajustes
    in-out property <bool> tags-open: false;
    in-out property <string> tags-title;
    in-out property <string> tags-artist;
    in-out property <string> tags-album;
    in property <string> tags-path;
    in property <string> tags-status;
    in-out property <bool> settings-open: false;
    in-out property <string> acoustid-key;

    // Diálogos de listas
    in-out property <bool> input-open: false;
    in property <string> input-title;
    in-out property <string> input-text;
    in-out property <bool> confirm-open: false;
    in property <string> confirm-text;
    in-out property <bool> pick-open: false;
    in property <string> pick-title;
    in-out property <string> pick-new-name;

    callback open-folder();
    callback play-track(int);
    callback toggle-play();
    callback prev();
    callback next();
    callback seek(float);
    callback volume-changed(float);
    callback search(string);
    callback folder-selected(string);
    callback header-clicked(string);
    callback toggle-group();
    callback layout-changed();
    callback edit-lyrics();
    callback cancel-edit();
    callback save-lyrics(string);
    callback delete-lyrics();
    callback search-lyrics(string, string);
    callback web-lyrics(string, string);
    callback edit-tags(int);
    callback save-tags(string, string, string);
    callback set-buffer(int);
    callback mode-changed(string);
    callback playlist-selected(int);
    callback new-playlist();
    callback rename-playlist();
    callback delete-playlist();
    callback input-accepted(string);
    callback confirm-accepted();
    callback add-row(int);
    callback add-all();
    callback remove-row(int);
    callback pick-playlist(int);
    callback pick-new(string);
    callback save-acoustid(string);
    callback open-acoustid-page();

    // Desplaza la lista lo mínimo para que se vea la fila (mide 40 px); si ya se ve, no mueve nada.
    public function ensure-visible(row: int) {
        if (row >= 0) {
            if (row * 40px < -track-list.content-y) {
                track-list.content-y = -(row * 40px);
            } else if ((row + 1) * 40px > -track-list.content-y + track-list.visible-height) {
                track-list.content-y = -((row + 1) * 40px - track-list.visible-height);
            }
        }
    }

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // ---- Carpetas / Listas ----
            Rectangle {
                width: root.sidebar-w;
                background: #0b0d11;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        TextButton { label: "Carpetas"; primary: root.sidebar-mode == "folders"; clicked => { root.mode-changed("folders"); } }
                        TextButton { label: "Listas"; primary: root.sidebar-mode == "lists"; clicked => { root.mode-changed("lists"); } }
                    }
                    if root.sidebar-mode == "folders": ListView {
                        vertical-stretch: 1;
                        for f[i] in root.folders: Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: f.path == root.selected-folder ? #22304a : (fta.has-hover ? #ffffff0d : transparent);
                            HorizontalLayout {
                                padding-left: 10px + f.depth * 14px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text { text: f.name; color: f.path == root.selected-folder ? #ffffff : #c4c7cc; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "\{f.count}"; color: #6b7280; font-size: 11px; vertical-alignment: center; }
                            }
                            fta := TouchArea { clicked => { root.folder-selected(f.path); } }
                        }
                    }
                    if root.sidebar-mode == "lists": ListView {
                        vertical-stretch: 1;
                        for pl in root.playlists: Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: pl.id == root.selected-playlist ? #22304a : (pta.has-hover ? #ffffff0d : transparent);
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text { text: pl.name; color: pl.id == root.selected-playlist ? #ffffff : #c4c7cc; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "\{pl.count}"; color: #6b7280; font-size: 11px; vertical-alignment: center; }
                            }
                            pta := TouchArea { clicked => { root.playlist-selected(pl.id); } }
                        }
                    }
                    if root.sidebar-mode == "lists": TextButton { label: "Nueva lista"; primary: true; clicked => { root.new-playlist(); } }
                    if root.sidebar-mode == "lists" && root.selected-playlist >= 0: HorizontalLayout {
                        spacing: 6px;
                        TextButton { label: "Renombrar"; clicked => { root.rename-playlist(); } }
                        TextButton { label: "Eliminar"; clicked => { root.delete-playlist(); } }
                    }
                }
            }
            Splitter { value <=> root.sidebar-w; min-value: 140px; max-value: 480px; released => { root.layout-changed(); } }

            // ---- Canciones ----
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 380px;
                padding: 16px;
                spacing: 10px;
                changed width => { root.center-w = self.width; }

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        background: #1a1d24;
                        border-radius: 8px;
                        search-input := TextInput {
                            x: 12px;
                            y: (parent.height - self.height) / 2;
                            width: parent.width - 24px;
                            color: #ffffff;
                            font-size: 14px;
                            edited => { root.search(self.text); }
                        }
                        Text {
                            x: 12px;
                            y: (parent.height - self.height) / 2;
                            text: "Buscar en tu biblioteca";
                            color: #6b7280;
                            font-size: 14px;
                            visible: search-input.text == "";
                        }
                    }
                    Rectangle {
                        width: 150px;
                        height: 36px;
                        border-radius: 8px;
                        background: root.group-artist ? (grp-ta.has-hover ? #3b82f6 : #2f6fe0) : (grp-ta.has-hover ? #ffffff2e : #ffffff14);
                        Text { text: "Agrupar por artista"; color: #ffffff; font-size: 12px; }
                        grp-ta := TouchArea { clicked => { root.toggle-group(); } }
                    }
                    Rectangle {
                        width: 130px;
                        height: 36px;
                        border-radius: 8px;
                        background: open-ta.has-hover ? #3b82f6 : #2f6fe0;
                        Text { text: "Agregar carpeta"; color: #ffffff; font-size: 13px; }
                        open-ta := TouchArea { clicked => { root.open-folder(); } }
                    }
                }

                // Cabecera de columnas: clic = ordenar; arrastrar el borde = ancho.
                Rectangle {
                    height: 28px;
                    background: #12151b;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        HeaderCell { width: root.eff-title; label: "Título"; active: root.sort-col == "title"; desc: root.sort-desc; clicked => { root.header-clicked("title"); } }
                        HeaderCell { width: root.eff-artist; label: "Artista"; active: root.sort-col == "artist"; desc: root.sort-desc; clicked => { root.header-clicked("artist"); } }
                        HeaderCell { horizontal-stretch: 1; label: "Álbum"; active: root.sort-col == "album"; desc: root.sort-desc; clicked => { root.header-clicked("album"); } }
                        HeaderCell { width: 56px; label: "Dur."; active: root.sort-col == "duration"; desc: root.sort-desc; clicked => { root.header-clicked("duration"); } }
                        Rectangle { width: 28px; }
                        Rectangle { width: 28px; }
                    }
                    Splitter { x: 12px + root.eff-title + 2px; height: parent.height; value <=> root.title-w; min-value: 100px; max-value: max(100px, root.avail - root.eff-artist - 60px); released => { root.layout-changed(); } }
                    Splitter { x: 12px + root.eff-title + 10px + root.eff-artist + 2px; height: parent.height; value <=> root.artist-w; min-value: 60px; max-value: max(60px, root.avail - root.eff-title - 60px); released => { root.layout-changed(); } }
                }

                track-list := ListView {
                    vertical-stretch: 1;
                    for t[i] in root.tracks: Rectangle {
                        height: 40px;
                        if t.header: Rectangle {
                            background: #151922;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                Text { text: t.title; color: #8ab4ff; font-size: 13px; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { text: t.artist; color: #6b7280; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                        if !t.header: Rectangle {
                            border-radius: 6px;
                            background: t.id == root.current-id ? #22304a : (row-ta.has-hover ? #ffffff0d : transparent);
                            row-ta := TouchArea { double-clicked => { root.play-track(t.index); } }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                Text { width: root.eff-title; text: t.title; color: #ffffff; font-size: 14px; overflow: elide; vertical-alignment: center; }
                                Text { width: root.eff-artist; text: t.artist; color: #9aa0a6; font-size: 13px; overflow: elide; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: t.album; color: #9aa0a6; font-size: 13px; overflow: elide; vertical-alignment: center; }
                                Text { width: 56px; text: t.duration; color: #9aa0a6; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
                                Rectangle {
                                    width: 28px;
                                    edit-ta := TouchArea { clicked => { root.edit-tags(t.index); } }
                                    Path {
                                        x: (parent.width - 12px) / 2;
                                        y: (parent.height - 12px) / 2;
                                        width: 12px;
                                        height: 12px;
                                        viewbox-width: 12;
                                        viewbox-height: 12;
                                        commands: "M 1 11 L 1 8 L 8 1 L 11 4 L 4 11 Z";
                                        fill: edit-ta.has-hover ? #8ab4ff : #6b7280;
                                    }
                                }
                                Rectangle {
                                    width: 28px;
                                    pl-ta := TouchArea {
                                        clicked => {
                                            if (root.in-playlist) { root.remove-row(t.index); } else { root.add-row(t.index); }
                                        }
                                    }
                                    Path {
                                        x: (parent.width - 12px) / 2;
                                        y: (parent.height - 12px) / 2;
                                        width: 12px;
                                        height: 12px;
                                        viewbox-width: 12;
                                        viewbox-height: 12;
                                        commands: root.in-playlist ? "M 0 5 L 12 5 L 12 7 L 0 7 Z" : "M 5 0 L 7 0 L 7 5 L 12 5 L 12 7 L 7 7 L 7 12 L 5 12 L 5 7 L 0 7 L 0 5 L 5 5 Z";
                                        fill: pl-ta.has-hover ? #8ab4ff : #6b7280;
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.status-text; color: #6b7280; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    if root.tracks.length > 0 && !root.in-playlist: TextButton { label: "Añadir todas a una lista"; width: 180px; height: 26px; clicked => { root.add-all(); } }
                }
            }
            Splitter { value <=> root.lyrics-w; sign: -1; min-value: 220px; max-value: 640px; released => { root.layout-changed(); } }

            // ---- Letra ----
            Rectangle {
                width: root.lyrics-w;
                background: #12151b;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.editing ? "Editar letra" : "Letra"; color: #9aa0a6; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                        if !root.editing && root.current-id >= 0: TextButton { label: "Editar"; width: 64px; clicked => { root.edit-lyrics(); } }
                        if !root.editing && root.current-id >= 0: TextButton { label: "Eliminar"; width: 72px; clicked => { root.delete-lyrics(); } }
                    }
                    if !root.editing: Text { text: root.lyrics-status; color: #6b7280; font-size: 12px; wrap: word-wrap; visible: root.lyrics-status != ""; }
                    if !root.editing: lyr-scroll := ScrollView {
                        vertical-stretch: 1;
                        animate content-y { duration: 300ms; easing: ease-in-out; }
                        lyr-col := VerticalLayout {
                            width: lyr-scroll.visible-width;
                            spacing: 8px;
                            for l in root.lyrics: LyricRow {
                                text: l.text;
                                current: l.current;
                                became-current(y) => {
                                    lyr-scroll.content-y = clamp(-y + lyr-scroll.visible-height * 0.35, min(0px, lyr-scroll.visible-height - lyr-col.preferred-height), 0px);
                                }
                            }
                        }
                    }
                    if root.editing: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 8px;
                        Text { text: root.edit-name; color: #c4c7cc; font-size: 12px; overflow: elide; }
                        LineEdit { placeholder-text: "Artista"; text <=> root.edit-artist; }
                        LineEdit { placeholder-text: "Título"; text <=> root.edit-title; }
                        HorizontalLayout {
                            spacing: 6px;
                            TextButton { label: "Buscar letra"; clicked => { root.search-lyrics(root.edit-artist, root.edit-title); } }
                            TextButton { label: "Buscar en la web"; clicked => { root.web-lyrics(root.edit-artist, root.edit-title); } }
                        }
                        Text { text: root.edit-status; color: #8ab4ff; font-size: 11px; wrap: word-wrap; visible: root.edit-status != ""; }
                        TextEdit { vertical-stretch: 1; text <=> root.edit-text; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 6px;
                            TextButton { label: "Guardar"; primary: true; clicked => { root.save-lyrics(root.edit-text); } }
                            TextButton { label: "Cancelar"; clicked => { root.editing = false; } }
                        }
                    }
                }
            }
        }

        // ---- Barra de reproducción ----
        Rectangle {
            height: 84px;
            background: #12151b;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 20px;

                VerticalLayout {
                    width: 240px;
                    alignment: center;
                    Text { text: root.now-title; color: #ffffff; font-size: 14px; font-weight: 600; overflow: elide; }
                    Text { text: root.now-artist; color: #9aa0a6; font-size: 12px; overflow: elide; }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 14px;
                        IconButton {
                            size: 34px;
                            clicked => { root.prev(); }
                            Rectangle { x: (parent.width - 14px) / 2; y: (parent.height - 12px) / 2; width: 2px; height: 12px; background: #ffffff; }
                            Path { x: (parent.width - 14px) / 2 + 3px; y: (parent.height - 12px) / 2; width: 11px; height: 12px; viewbox-width: 11; viewbox-height: 12; commands: "M 11 0 L 0 6 L 11 12 Z"; fill: #ffffff; }
                        }
                        IconButton {
                            size: 44px;
                            fill: #e8eaed;
                            clicked => { root.toggle-play(); }
                            Path {
                                visible: !root.playing;
                                x: (parent.width - 14px) / 2 + 1px; y: (parent.height - 16px) / 2;
                                width: 14px; height: 16px; viewbox-width: 14; viewbox-height: 16;
                                commands: "M 0 0 L 14 8 L 0 16 Z"; fill: #0e1014;
                            }
                            Rectangle { visible: root.playing; x: (parent.width - 12px) / 2; y: (parent.height - 16px) / 2; width: 4px; height: 16px; background: #0e1014; }
                            Rectangle { visible: root.playing; x: (parent.width - 12px) / 2 + 8px; y: (parent.height - 16px) / 2; width: 4px; height: 16px; background: #0e1014; }
                        }
                        IconButton {
                            size: 34px;
                            clicked => { root.next(); }
                            Path { x: (parent.width - 14px) / 2; y: (parent.height - 12px) / 2; width: 11px; height: 12px; viewbox-width: 11; viewbox-height: 12; commands: "M 0 0 L 11 6 L 0 12 Z"; fill: #ffffff; }
                            Rectangle { x: (parent.width - 14px) / 2 + 12px; y: (parent.height - 12px) / 2; width: 2px; height: 12px; background: #ffffff; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: root.position-text; color: #9aa0a6; font-size: 11px; width: 40px; horizontal-alignment: right; vertical-alignment: center; }
                        Bar { horizontal-stretch: 1; value: root.progress; changed(v) => { root.seek(v); } }
                        Text { text: root.duration-text; color: #9aa0a6; font-size: 11px; width: 40px; vertical-alignment: center; }
                    }
                }

                VerticalLayout {
                    width: 170px;
                    alignment: center;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.underruns > 0 ? "cortes: \{root.underruns}" : ""; color: #f59e0b; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                        TextButton { label: "Ajustes"; width: 70px; height: 26px; clicked => { root.settings-open = true; } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Vol"; color: #9aa0a6; font-size: 11px; vertical-alignment: center; }
                        Bar { horizontal-stretch: 1; value: root.volume; changed(v) => { root.volume = v; root.volume-changed(v); } }
                    }
                }
            }
        }
    }

    // ---- Diálogo: editar etiquetas ----
    if root.tags-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000b8;
        TouchArea { }
        Rectangle {
            width: 480px;
            height: 340px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #1a1d24;
            border-radius: 10px;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Editar etiquetas"; color: #ffffff; font-size: 16px; font-weight: 700; }
                Text { text: root.tags-path; color: #6b7280; font-size: 11px; overflow: elide; }
                LineEdit { placeholder-text: "Título"; text <=> root.tags-title; }
                LineEdit { placeholder-text: "Artista"; text <=> root.tags-artist; }
                LineEdit { placeholder-text: "Álbum"; text <=> root.tags-album; }
                Text { text: root.tags-status; color: #f59e0b; font-size: 12px; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    TextButton { label: "Guardar en el archivo"; primary: true; clicked => { root.save-tags(root.tags-title, root.tags-artist, root.tags-album); } }
                    TextButton { label: "Cancelar"; clicked => { root.tags-open = false; } }
                }
            }
        }
    }

    // ---- Diálogo: ajustes de audio ----
    if root.settings-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000b8;
        TouchArea { }
        Rectangle {
            width: 560px;
            height: 470px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #1a1d24;
            border-radius: 10px;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Ajustes de audio"; color: #ffffff; font-size: 16px; font-weight: 700; }
                Text { text: "Tamaño del búfer: si oyes cortes en el sonido, sube un nivel. Un búfer mayor aguanta mejor los tirones del equipo, pero la pausa y el volumen tardan un poco más en notarse. Se aplica desde la siguiente canción."; color: #9aa0a6; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    TextButton { label: "Pequeño"; primary: root.audio-buffer == 4096; clicked => { root.set-buffer(4096); } }
                    TextButton { label: "Normal"; primary: root.audio-buffer == 8192; clicked => { root.set-buffer(8192); } }
                    TextButton { label: "Grande"; primary: root.audio-buffer == 16384; clicked => { root.set-buffer(16384); } }
                    TextButton { label: "Máximo"; primary: root.audio-buffer == 32768; clicked => { root.set-buffer(32768); } }
                }
                Text { text: "Búfer actual: \{root.audio-buffer} tramas (unos \{round(root.audio-buffer / 48.0)} ms a 48 kHz)"; color: #8ab4ff; font-size: 12px; }
                Text { text: "Cortes de audio detectados en esta sesión: \{root.underruns}"; color: #8ab4ff; font-size: 12px; }
                Text { text: "Identificación de canciones (AcoustID)"; color: #ffffff; font-size: 13px; font-weight: 600; }
                Text { text: "Pega aquí tu clave de APLICACIÓN de AcoustID (gratuita: acoustid.org/new-application). No es la «clave de usuario» que se ve al iniciar sesión. Se usará para identificar canciones solo cuando tú lo pidas."; color: #9aa0a6; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: "Clave de aplicación de AcoustID"; text <=> root.acoustid-key; horizontal-stretch: 1; }
                    TextButton { label: "Obtener clave"; width: 110px; clicked => { root.open-acoustid-page(); } }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    TextButton { label: "Cerrar"; width: 90px; clicked => { root.save-acoustid(root.acoustid-key); root.settings-open = false; } }
                }
            }
        }
    }

    // ---- Diálogo: nombre de lista (crear / renombrar) ----
    if root.input-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000b8;
        TouchArea { }
        Rectangle {
            width: 420px;
            height: 190px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #1a1d24;
            border-radius: 10px;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: root.input-title; color: #ffffff; font-size: 16px; font-weight: 700; }
                LineEdit { placeholder-text: "Nombre de la lista"; text <=> root.input-text; accepted => { root.input-accepted(root.input-text); } }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    TextButton { label: "Aceptar"; primary: true; clicked => { root.input-accepted(root.input-text); } }
                    TextButton { label: "Cancelar"; clicked => { root.input-open = false; } }
                }
            }
        }
    }

    // ---- Diálogo: confirmar eliminación ----
    if root.confirm-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000b8;
        TouchArea { }
        Rectangle {
            width: 440px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #1a1d24;
            border-radius: 10px;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: root.confirm-text; color: #ffffff; font-size: 14px; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    TextButton { label: "Eliminar lista"; primary: true; clicked => { root.confirm-accepted(); } }
                    TextButton { label: "Cancelar"; clicked => { root.confirm-open = false; } }
                }
            }
        }
    }

    // ---- Diálogo: añadir a una lista ----
    if root.pick-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000b8;
        TouchArea { }
        Rectangle {
            width: 440px;
            height: 430px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #1a1d24;
            border-radius: 10px;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: root.pick-title; color: #ffffff; font-size: 15px; font-weight: 700; wrap: word-wrap; }
                if root.pick-lists.length == 0: Text { text: "Aún no tienes listas: crea la primera aquí abajo."; color: #9aa0a6; font-size: 12px; vertical-stretch: 1; }
                if root.pick-lists.length > 0: ListView {
                    vertical-stretch: 1;
                    for pl in root.pick-lists: Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: pk-ta.has-hover ? #22304a : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            Text { text: pl.name; color: #ffffff; font-size: 14px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: "\{pl.count}"; color: #6b7280; font-size: 12px; vertical-alignment: center; }
                        }
                        pk-ta := TouchArea { clicked => { root.pick-playlist(pl.id); } }
                    }
                }
                Text { text: "O crea una lista nueva con ellas:"; color: #9aa0a6; font-size: 12px; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: "Nombre de la nueva lista"; text <=> root.pick-new-name; horizontal-stretch: 1; accepted => { root.pick-new(root.pick-new-name); } }
                    TextButton { label: "Crear y añadir"; width: 120px; primary: true; clicked => { root.pick-new(root.pick-new-name); } }
                }
                HorizontalLayout {
                    TextButton { label: "Cancelar"; width: 90px; clicked => { root.pick-open = false; } }
                }
            }
        }
    }
}
